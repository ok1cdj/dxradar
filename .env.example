# DX Cluster Settings (Optional, defaults are used if not set)
DX_CLUSTER_HOST=ve7cc.net
DX_CLUSTER_PORT=23
DX_CLUSTER_CALLSIGN=GUEST
DX_CLUSTER_COMMANDS=SET/SKIMMER,SET/FT8,SET/FT4

# Backup DX Cluster (Optional) — automatic failover target when the primary
# goes down or its feed goes silent. Leave HOST_BACKUP empty to disable.
DX_CLUSTER_HOST_BACKUP=
DX_CLUSTER_PORT_BACKUP=23
# Seconds of complete silence before a connected cluster is treated as an outage
DX_CLUSTER_STALE_SECONDS=90
# Minutes between retrying the preferred primary while running on the backup
DX_CLUSTER_FAILBACK_MINUTES=15

# App Settings
# (NODE_ENV and PORT are handled by the infrastructure)

# Club Log Settings (Optional, can be set in UI)
CLUBLOG_EMAIL=
CLUBLOG_PASSWORD=
CLUBLOG_API_KEY=
MY_CALLSIGN=

# QO-100 FT8/FT4/CW skimmer (QO100-FT-skimmer). docker-compose.yml defaults QO100_SKIMMER_URL to
# the skimmer container on the "radio" network; set it here for a skimmer on another host (no
# trailing slash). The token must equal SKIMMER_INTERNAL_TOKEN in the skimmer's .env.
QO100_SKIMMER_TOKEN=
# QO100_SKIMMER_URL=https://qo100.ok1cdj.com
# QO100_SKIMMER_SPOTTER=QO100-#
# QO100_SKIMMER_CONT=EU
